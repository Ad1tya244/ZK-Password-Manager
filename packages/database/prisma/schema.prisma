generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique

  passwordHash    String
  salt            String
  vaultSalt       String?  // Explicit salt for Vault Key derivation
  twoFactorSecret String? // TOTP Secret for Google Authenticator

  encryptedVEK    Bytes?
  vekIV           Bytes?
  vekAuthTag      Bytes?

  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?

  recoveryKeyHash      String?  @unique
  recoveryEncryptedVEK Bytes?
  recoveryVekIV        Bytes?
  recoveryVekAuthTag   Bytes?
  recoveryConfiguredAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
  Vault        Vault[]
  Session      Session[]
}

model Vault {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AES-GCM encrypted JSON containing site, username, password, and optional notes
  encryptedBlob Bytes
  iv        Bytes
  authTag   Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vault")
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  deviceInfo String?

  @@map("sessions")
}

